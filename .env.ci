# Throwaway secrets for CI smoke only (issue #37). Safe to commit: these values
# never touch prod. The release job does `cp .env.ci .env` inside the CI runner
# to boot a disposable stack, runs smoke, then `docker compose down -v`.
DEBUG=False
SECRET_KEY=ci-not-a-secret-do-not-use-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=uceltic
DB_USER=postgres
DB_PASSWORD=ci-postgres