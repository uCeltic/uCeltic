# Copy to .env for docker compose. Never commit .env.

DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Hosts the browser uses to reach the proxy. On the VPS add the sslip.io host,
# e.g. ALLOWED_HOSTS=localhost,127.0.0.1,1.2.3.4.sslip.io (#63)
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins Django trusts for CSRF checks. On the VPS set
# CSRF_TRUSTED_ORIGINS=https://1.2.3.4.sslip.io (#63); leave blank for local dev.
CSRF_TRUSTED_ORIGINS=

# Postgres (shared by the db service and Django)
DB_NAME=uceltic
DB_USER=postgres
DB_PASSWORD=change-me

# Auto-create a Django admin on first boot (for uploading TEI via /admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin

# --- Accounts (#64) ---
# Where the SPA lives, as a mail client sees it: activation and password-reset links are
# built from this. On the VPS: https://<SERVER_IP>.sslip.io — no trailing slash.
FRONTEND_BASE_URL=http://localhost:5173

# Outbound mail for activation links. Leave EMAIL_HOST blank and Django prints the mail to
# the console instead of sending it (fine for local dev; useless in production).
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=<you>@gmail.com, and an *app password*
# (not your login password) in EMAIL_HOST_PASSWORD. Brevo's free tier works the same way.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=uCeltic <no-reply@example.com>


# --- Production / VPS deploy (#9) only; leave blank for local dev ---
# VPS public IP. Caddy serves the site at https://<SERVER_IP>.sslip.io (#63);
# that hostname must also be in ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS above.
SERVER_IP=
