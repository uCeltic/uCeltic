# Copy to .env for docker compose. Never commit .env.

DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Hosts the browser uses to reach the proxy. Add your VPS IP at deploy time (#9).
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (shared by the db service and Django)
DB_NAME=uceltic
DB_USER=postgres
DB_PASSWORD=change-me

# Auto-create a Django admin on first boot (for uploading TEI via /admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-admin


# --- Production / VPS deploy (#9) only; leave blank for local dev ---
# VPS public IP. Used as Caddy's HTTPS site address AND must also be in ALLOWED_HOSTS above.
SERVER_IP=
# Basic Auth bcrypt hash (the username is "celtic", set in Caddyfile.prod).
# SINGLE-QUOTE the value in your real .env so the $ in the bcrypt hash is NOT interpolated.
# Generate it with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=