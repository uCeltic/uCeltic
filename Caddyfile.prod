# Production reverse proxy for the private VPS deploy (issue #9).
# Mounted over /etc/caddy/Caddyfile by docker-compose.prod.yml.
# SERVER_IP and BASIC_AUTH_HASH come from the VPS .env (env_file on the web service).
https://{$SERVER_IP} {
    # Self-signed cert from Caddy's internal CA (raw IP, no domain).
    # Visitors accept a one-time browser warning. Caddy also redirects :80 -> :443.
    tls internal

    encode gzip

    # Gate EVERY path (frontend, /api, /admin) with HTTP Basic Auth.
    # basic_auth is ordered before handle/reverse_proxy/file_server, so an
    # unauthenticated request gets 401 before it can reach Django or the SPA.
    basic_auth {
            celtic {$BASIC_AUTH_HASH}
    }

    # API, admin, and Django static (WhiteNoise) -> backend.
    # Bare paths included so /admin (no slash) reaches Django's APPEND_SLASH redirect.
    @backend path /api /api/* /admin /admin/* /static /static/*
    handle @backend {
            reverse_proxy backend:8000
    }

    # Everything else is the React single-page app.
    handle {
            root * /srv
            try_files {path} /index.html
            file_server
    }
}