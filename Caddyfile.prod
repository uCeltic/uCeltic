# Production reverse proxy for the VPS deploy (issues #9, #63; public per ADR-0004).
# Mounted over /etc/caddy/Caddyfile by docker-compose.prod.yml.
# SERVER_IP comes from the VPS .env (env_file on the web service).

# sslip.io resolves <ip>.sslip.io to <ip> with zero DNS setup, giving us a real
# hostname. Caddy auto-issues a Let's Encrypt certificate for it (ACME HTTP-01
# on port 80) and redirects :80 -> :443. Swapping to a paid domain later is a
# one-line change of this site address.
https://{$SERVER_IP}.sslip.io {
    encode gzip

    # API, admin, and Django static (WhiteNoise) -> backend.
    # Bare paths included so /admin (no slash) reaches Django's APPEND_SLASH redirect.
    @backend path /api /api/* /admin /admin/* /static /static/*
    handle @backend {
            reverse_proxy backend:8000
    }

    # Everything else is the React single-page app.
    handle {
            root * /srv
            try_files {path} /index.html
            file_server
    }
}
