# Local dev: set DEBUG=True so the app runs without production secrets
DEBUG=True

# Required in production (DEBUG=False). Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated, e.g. 1.2.3.4,example.com
ALLOWED_HOSTS=

# Postgres
DB_PASSWORD=
DB_NAME=uceltic
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# Accounts (#64). The Vite dev server is the SPA in dev, so activation links point at it.
FRONTEND_BASE_URL=http://localhost:5173

# Leave EMAIL_HOST blank in dev: activation mail (link included) is printed to the console
# that runs `manage.py runserver` instead of being sent. See the root .env.example for the
# SMTP settings production needs.
EMAIL_HOST=
