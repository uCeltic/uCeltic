<l>do <name type="person" nymRef="M44">Mor<expan>n</expan>a</name> g<expan>us</expan>i<expan>n</expan> moirmhēi<expan>n</expan></l>
<l>Cethr<expan>ur</expan> dōib-sei<expan>n</expan> d<expan>r</expan>eimne gal</l>
