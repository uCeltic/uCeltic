<lg type="quatrain" n="14"> 
<l><name type="person" nymRef="E19">Eoch<expan>aid</expan> m<expan>a</expan>c Nā<expan>r</expan>cadha</name> anai<expan>r</expan></l>
<l>rī ḟian<expan>n</expan> <name type="place" nymRef="e6">Ēir<expan>enn</expan></name> a <name type="place" nymRef="u4">hUll<expan>taib</expan>h</name></l>
<l>blīad<expan>ain</expan> co l<expan>eit</expan>h a lí<expan>n</expan>e</l>
