<lg type="quatrain" n="16"> 
<l>Gabhsat a <name type="place" nymRef="m34">M<expan>um</expan>ai<expan>n</expan></name>, mīadh cealg,</l>
<l><name type="person" nymRef="L13">Līath Lūac<expan>r</expan>a</name> is <name type="person" nymRef="L2">Lab<expan>r</expan>adh Lāi<expan>m</expan>hd<expan>er</expan>g</name></l>
